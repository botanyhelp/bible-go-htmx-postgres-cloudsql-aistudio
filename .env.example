# Google Cloud SQL PostgreSQL Connection Configuration

# Database Host (Use Cloud SQL Private IP 172.18.160.3 or 127.0.0.1 when using Cloud SQL Auth Proxy)
DB_HOST="172.18.160.3"

# Database Port (Default PostgreSQL Port)
DB_PORT="5432"

# Database User
DB_USER="postgres"

# Database User Password
DB_PASSWORD="YourSecureCloudSQLPasswordHere"

# Database Name
DB_NAME="scriptures"

# SSL Mode (disable for Private IP / Direct VPC Egress or require/verify-full with SSL certs)
DB_SSLMODE="disable"

# Cloud SQL Instance Connection Name
INSTANCE_CONNECTION_NAME="gkecluster-423317:us-central1:indy"

# HTTP Web Server Port
PORT="3000"
